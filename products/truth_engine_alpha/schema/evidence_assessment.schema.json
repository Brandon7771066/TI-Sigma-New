{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/truth-engine-alpha/evidence-assessment.schema.json",
  "title": "Truth Engine Alpha Evidence Assessment",
  "type": "object",
  "required": ["source_type"],
  "properties": {
    "source_type": {"type": "string"},
    "study_design": {"type": ["string", "null"]},
    "sample_size": {"type": ["integer", "null"]},
    "replication": {"type": ["string", "null"]},
    "directness": {"type": ["string", "null"]},
    "risk_of_bias": {"type": ["string", "null"]},
    "measurement_quality": {"type": ["string", "null"]},
    "statistical_uncertainty": {"type": ["string", "null"]},
    "external_validity": {"type": ["string", "null"]},
    "recency": {"type": ["string", "null"]},
    "citation_support": {"type": ["string", "null"]},
    "independence_of_sources": {"type": ["string", "null"]},
    "summary_rating": {"type": ["string", "null"]},
    "evidence_level": {"type": "string"}
  },
  "additionalProperties": false
}