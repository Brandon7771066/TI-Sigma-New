{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/truth-engine-alpha/analysis-result.schema.json",
  "title": "Truth Engine Alpha Analysis Result",
  "type": "object",
  "required": [
    "analysis_id",
    "claims",
    "sources",
    "contradictions",
    "scaffolding_candidates",
    "evidence_assessment",
    "resolution_status",
    "confidence",
    "critical_unknowns",
    "recommended_actions",
    "commercial_opportunities",
    "limitations",
    "truth_engine_level",
    "truth_engine_score",
    "contradiction_graph",
    "information_gain",
    "claim_labels",
    "citation_audit",
    "scaffolding_analysis",
    "safety_labels",
    "schema_version",
    "static_artifacts_disclosed",
    "claim_graph",
    "graph_errors",
    "crystal_matrix",
    "crystal_diagnostics",
    "crystal_explanation"
  ],
  "properties": {
    "analysis_id": {"type": "string"},
    "claims": {"type": "array", "items": {"type": "object"}},
    "sources": {"type": "array", "items": {"type": "object"}},
    "contradictions": {"type": "array", "items": {"type": "object"}},
    "scaffolding_candidates": {"type": "array", "items": {"type": "object"}},
    "evidence_assessment": {"type": "object"},
    "resolution_status": {"type": "string", "enum": ["resolved", "partially_resolved", "unresolved", "insufficient_evidence"]},
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "critical_unknowns": {"type": "array", "items": {"type": "string"}},
    "recommended_actions": {"type": "array", "items": {"type": "object"}},
    "commercial_opportunities": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "truth_engine_level": {"type": "integer", "minimum": 1, "maximum": 8},
    "truth_engine_score": {"type": "object"},
    "contradiction_graph": {"type": "object"},
    "information_gain": {"type": "array", "items": {"type": "object"}},
    "claim_labels": {"type": "object"},
    "research_mode_fields": {"type": "object"},
    "citation_audit": {"type": "array", "items": {"type": "object"}},
    "scaffolding_analysis": {"type": "array", "items": {"type": "object"}},
    "safety_labels": {"type": "array", "items": {"type": "string"}},
    "schema_version": {"type": "string"},
    "static_artifacts_disclosed": {"type": "boolean"},
    "claim_graph": {"type": "object"},
    "graph_errors": {"type": "array", "items": {"type": "object"}},
    "crystal_matrix": {"type": "array", "items": {"type": "object"}},
    "crystal_diagnostics": {"type": "object"},
    "crystal_explanation": {"type": "string"}
  },
  "additionalProperties": false
}